rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection: Publicly readable for creator catalog and admin statistics,
    // writable by users for profile updates and administrators for account approval verification
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Briefs Collection: Open briefs are publicly readable; direct briefs are strictly readable only by sender or recipient
    match /briefs/{briefId} {
      allow read: if resource == null
                  || resource.data.recipientType == 'open'
                  || (isSignedIn() && (
                        resource.data.brandId == request.auth.uid ||
                        resource.data.selectedCreatorId == request.auth.uid
                     ));
      allow write: if true;
    }

    // Conversations and messages
    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Transactions and referrals
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    match /referrals/{referralId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Cancellations Collection (Pro cancellation reasons and feedback)
    match /cancellations/{cancellationId} {
      allow read: if true;
      allow write: if true;
    }

    // Agency Applications Collection (Marketing agency partnership program)
    match /agencyApplications/{applicationId} {
      allow read: if true;
      allow write: if true;
    }

    // Payment Requests Collection (Manual card payment confirmation and receipts)
    match /paymentRequests/{requestId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
