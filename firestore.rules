rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Authentication & Authorization Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == "iNS0otBw1ZalMMhyYUntV1W5ADF3";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isRecordOwner(data) {
      return isSignedIn() && (
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        (('userId' in data) && data.userId == request.auth.uid)
      );
    }

    // Protected fields on /users/{userId} that ONLY admin can modify
    function hasProtectedUserFieldChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid',
        'role',
        'isAdmin',
        'permissions',
        'accountStatus',
        'status',
        'rejectionReason',
        'verified',
        'isVerified',
        'subscriptionStatus',
        'isPro',
        'proStatus',
        'trialStartDate',
        'trialEndDate',
        'subscriptionPlanPrice',
        'topPlacementUntil',
        'paymentStatus',
        'paidAmount',
        'balance',
        'unlockedContactsCount',
        'unlockedCreators',
        'lastUnlockedCreatorId',
        'proExpiresAtMillis',
        'referralCount',
        'referredBy',
        'referralBalance',
        'referralEarnedTotal',
        'referralRewarded',
        'catalogApproved',
        'catalogRejectReason',
        'catalogReviewedAtMillis'
      ]);
    }

    function isValidInitialUserCreate(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.role in ['bloger', 'brend']
        && (!('accountStatus' in data) || data.accountStatus in ['pending', 'approved'])
        && (!('status' in data) || data.status in ['pending', 'approved'])
        && (!('verified' in data) || data.verified == false)
        && (!('isVerified' in data) || data.isVerified == false)
        && (!('subscriptionStatus' in data) || data.subscriptionStatus in ['free', 'none'])
        && (!('isPro' in data) || data.isPro == false)
        && (!('proStatus' in data) || data.proStatus in ['free', 'none'])
        && !('trialStartDate' in data)
        && !('trialEndDate' in data)
        && (!('topPlacementUntil' in data) || data.topPlacementUntil == null)
        && (!('unlockedContactsCount' in data) || data.unlockedContactsCount == 0)
        && !('unlockedCreators' in data)
        && !('paymentStatus' in data)
        && !('paidAmount' in data)
        && !('balance' in data)
        && (!('referralCount' in data) || data.referralCount == 0)
        && (!('referredBy' in data) || (
          data.referredBy is string
          && data.referredBy.size() >= 1
          && data.referredBy.size() <= 128
          && data.referredBy != userId
        ))
        && !('referralBalance' in data)
        && !('referralEarnedTotal' in data)
        && !('referralRewarded' in data)
        && !('catalogApproved' in data)
        && !('catalogRejectReason' in data)
        && !('catalogReviewedAtMillis' in data)
        && !('isAdmin' in data)
        && !('permissions' in data)
        && !('proExpiresAtMillis' in data)
        && !('lastUnlockedCreatorId' in data);
    }

    // 1. Users Collection:
    // - Read open to everyone (for public creator catalog)
    // - Write only own document (without modifying status, verified, Pro, payment, or role) or admin
    match /users/{userId} {
      allow get, list: if request.time != null;

      allow create: if isAdmin() || (
        isOwner(userId)
        && isValidId(userId)
        && isValidInitialUserCreate(userId)
      );

      allow update: if isAdmin() || isSpendingUnlockCredit(userId) || isViewIncrement(userId) || (
        isOwner(userId)
        && isValidId(userId)
        && !hasProtectedUserFieldChanges()
        && (!('name' in request.resource.data) || (
          request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 200
        ))
      );

      allow delete: if isAdmin() || isOwner(userId);
    }

    // ===== Kontakt ochish (72 soat) va yopiq kontaktlar =====
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Boshqa foydalanuvchi profilni ko'rganda faqat 'views' ni 1 taga oshirish mumkin
    function isViewIncrement(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // Brend o'z balansidan aynan 1 ta kontakt sarflaydi va shu paketda ochish yozuvi yaratiladi
    function isSpendingUnlockCredit(userId) {
      let before = resource.data;
      let after = request.resource.data;
      return isOwner(userId)
        && after.diff(before).affectedKeys().hasOnly(['unlockedContactsCount', 'unlockedCreators', 'lastUnlockedCreatorId', 'updatedAt'])
        && before.get('unlockedContactsCount', 0) is int
        && before.get('unlockedContactsCount', 0) > 0
        && after.unlockedContactsCount == before.get('unlockedContactsCount', 0) - 1
        && after.lastUnlockedCreatorId is string
        && existsAfter(/databases/$(database)/documents/users/$(userId)/unlocks/$(after.lastUnlockedCreatorId));
    }

    function isReaderProBrand() {
      let d = get(userPath(request.auth.uid)).data;
      return d.get('role', '') == 'brend'
        && d.get('subscriptionStatus', '') in ['trial', 'active']
        && (d.get('proExpiresAtMillis', 0) == 0 || timestamp.value(d.get('proExpiresAtMillis', 0)) > request.time);
    }

    function hasValidUnlock(ownerId) {
      let p = /databases/$(database)/documents/users/$(request.auth.uid)/unlocks/$(ownerId);
      return exists(p) && get(p).data.expiresAt > request.time;
    }

    function hasContactGrant(ownerId) {
      return exists(/databases/$(database)/documents/users/$(ownerId)/contactGrants/$(request.auth.uid));
    }

    // Telefon, Telegram, email: faqat egasi, admin, Pro brend, 72 soat ochgan brend yoki ruxsat berilgan hamkor
    match /users/{userId}/private/{docId} {
      allow read: if isSignedIn() && (
        isOwner(userId) || isAdmin() || hasContactGrant(userId) || hasValidUnlock(userId) || isReaderProBrand()
      );
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Brendning kontakt ochish yozuvlari
    match /users/{userId}/unlocks/{creatorId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.keys().hasOnly(['creatorId', 'unlockedAt', 'expiresAt'])
        && request.resource.data.creatorId == creatorId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(73, 'h')
        && get(userPath(userId)).data.get('unlockedContactsCount', 0) > 0
        && getAfter(userPath(userId)).data.get('unlockedContactsCount', 0) == get(userPath(userId)).data.get('unlockedContactsCount', 0) - 1
        && getAfter(userPath(userId)).data.get('lastUnlockedCreatorId', '') == creatorId
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Hamkorga o'z kontaktini ko'rish ruxsati (brif qabul qilinganda)
    match /users/{userId}/contactGrants/{granteeId} {
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && request.auth.uid == granteeId);
      allow create, update: if isOwner(userId) && granteeId != userId;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Conversations & Messages:
    // - Strictly accessible only to conversation participants and admin
    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /conversations/{conversationId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          (resource == null && request.auth.uid in conversationId.split('_')) ||
          (resource != null && resource.data.participants is list && request.auth.uid in resource.data.participants)
        )
      );

      allow list: if isAdmin() || (
        isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
      );

      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(conversationId)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10
        && request.auth.uid in request.resource.data.participants
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || isConversationParticipant(conversationId);

        allow create: if isAdmin() || (
          isValidId(messageId)
          && isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
        );

        allow update: if isAdmin() || (
          isValidId(messageId)
          && isConversationParticipant(conversationId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        );

        allow delete: if isAdmin();
      }
    }

    // 3. Briefs Collection:
    // - Open briefs visible to everyone; direct briefs visible to owner, targeted creator, or admin
    // - Create only for signed-in users (setting own brandId/ownerId)
    // - Edit/delete only by owner or admin; targeted creator can accept/reject direct briefs; signed-in creators can apply to open briefs
    function isBriefOwner(data) {
      return isSignedIn() && (
        (('brandId' in data) && data.brandId == request.auth.uid) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid)
      );
    }

    function isTargetedCreator(data) {
      return isSignedIn()
        && ('selectedCreatorId' in data)
        && data.selectedCreatorId == request.auth.uid;
    }

    match /briefs/{briefId} {
      allow get: if isAdmin() || (
        resource != null && (
          resource.data.recipientType == 'open'
          || isBriefOwner(resource.data)
          || isTargetedCreator(resource.data)
        )
      );

      allow list: if isAdmin()
        || resource.data.recipientType == 'open'
        || isBriefOwner(resource.data)
        || isTargetedCreator(resource.data);

      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(briefId)
        && isBriefOwner(request.resource.data)
        && request.resource.data.recipientType in ['open', 'direct']
        && request.resource.data.taskTitle is string
        && request.resource.data.taskTitle.size() >= 1
        && request.resource.data.taskTitle.size() <= 300
      );

      allow update: if isAdmin() || (
        isSignedIn()
        && isValidId(briefId)
        && (
          // Owner editing own brief without changing ownership
          (isBriefOwner(resource.data) && request.resource.data.brandId == resource.data.brandId) ||
          // Targeted creator accepting or rejecting a direct brief sent to them
          (isTargetedCreator(resource.data)
            && request.resource.data.creatorStatus in ['qabul_qilindi', 'rad_etildi']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'creatorStatus',
              'status',
              'respondedAt',
              'respondedAtMillis',
              'updatedAt',
              'creatorPhoneNumber',
              'creatorTelegramUsername',
              'brandPhoneNumber',
              'brandTelegramUsername',
              'rejectionReason'
            ])
          ) ||
          // Signed-in creator submitting an application to an open brief
          (resource.data.recipientType == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applications', 'updatedAt'])
            && request.resource.data.applications is list
            && request.resource.data.applications.size() <= 200
          )
        )
      );

      allow delete: if isAdmin() || isBriefOwner(resource.data);
    }

    // 4. Payment Requests, Transactions, Cancellations, Agency Applications, Referrals:
    // - Create by signed-in owner; read only by owner and admin; update/delete strictly admin-only
    match /paymentRequests/{requestId} {
      allow get, list: if isAdmin() || isRecordOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(requestId)
        && isRecordOwner(request.resource.data)
        && request.resource.data.status == 'pending'
      );
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow get, list: if isAdmin() || isRecordOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(transactionId)
        && isRecordOwner(request.resource.data)
      );
      allow update, delete: if isAdmin();
    }

    match /cancellations/{cancellationId} {
      allow get, list: if isAdmin() || isRecordOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(cancellationId)
        && isRecordOwner(request.resource.data)
      );
      allow update, delete: if isAdmin();
    }

    match /agencyApplications/{applicationId} {
      allow get, list: if isAdmin() || isRecordOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(applicationId)
        && isRecordOwner(request.resource.data)
        && request.resource.data.status == 'yangi'
      );
      allow update, delete: if isAdmin();
    }

    // Referal mukofotini yechib olish so'rovlari (pulni admin qo'lda o'tkazadi)
    match /referrals/{referralId} {
      allow get, list: if isAdmin() || isRecordOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(referralId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'withdrawal'
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 29000
        && request.resource.data.amount <= get(userPath(request.auth.uid)).data.get('referralBalance', 0)
        && request.resource.data.cardNumber is string
        && request.resource.data.cardNumber.size() >= 16
        && request.resource.data.cardNumber.size() <= 19
      );
      allow update, delete: if isAdmin();
    }

    // 5. Notifications Collection:
    // - Read only by recipient or admin; create by signed-in users; update/delete by recipient or admin
    function isNotificationRecipient(data) {
      return isSignedIn() && (
        (('userId' in data) && data.userId == request.auth.uid) ||
        (('recipientId' in data) && data.recipientId == request.auth.uid)
      );
    }

    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || isNotificationRecipient(resource.data);

      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(notificationId)
        && request.resource.data.userId is string
        && request.resource.data.userId.size() >= 1
        && request.resource.data.userId.size() <= 128
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 600))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
      );

      allow update: if isAdmin() || (
        isNotificationRecipient(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt'])
      );

      allow delete: if isAdmin() || isNotificationRecipient(resource.data);
    }

    // 6. Settings Collection:
    // - Publicly readable (e.g. settings/catalog), writable only by Admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
